# Blade views (welcome, login, dashboard) use @vite() — that needs a real
# compiled public/build/manifest.json, which is gitignored and never
# committed. Build it here in a throwaway Node stage, then copy just the
# output into the final PHP image (no Node/node_modules in production).
FROM node:20 AS frontend
WORKDIR /app
COPY . .
RUN npm ci && npm run build

FROM php:8.4-cli

# mbstring: hard-required by laravel/framework's own composer.json — without
# it, `composer install` can fail its platform check before the app even runs.
# curl: Guzzle (and therefore Laravel's Http facade) prefers it over its
# stream-based fallback — this app's entire Flask integration goes through it.
# fileinfo: what Laravel's `mimes:pdf` validation rule uses to sniff the real
# file content type — every resume upload route validates against it.
RUN apt-get update && apt-get install -y \
    git unzip libpq-dev libzip-dev libcurl4-openssl-dev libonig-dev \
    && docker-php-ext-install pdo pdo_pgsql zip mbstring curl fileinfo \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY . .
COPY --from=frontend /app/public/build ./public/build

# Guaranteed to exist and be writable regardless of what .dockerignore
# excludes — Blade's compiled-view cache (storage/framework/views) and
# friends throw Symfony's "Please provide a valid cache path" if missing,
# and /up's health check never touches these, so this can pass a shallow
# health check while every real page 500s.
RUN mkdir -p storage/framework/{cache,cache/data,sessions,testing,views} storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

RUN composer install --no-dev --optimize-autoloader --no-interaction

RUN php artisan config:clear

EXPOSE 10000
CMD php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=${PORT:-10000}
